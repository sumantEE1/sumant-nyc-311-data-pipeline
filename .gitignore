# Local .terraform directories (contains provider binaries and modules)
**/.terraform/*

# .tfstate files (Contains sensitive system details and secrets)
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all variable files as they often contain secrets
*.tfvars
*.tfvars.json

# Ignore override files as they are usually local tweaks
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI configuration files
.terraformrc
terraform.rc